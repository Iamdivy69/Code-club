PORT=5010
DATABASE_URL=postgresql://practice:local_practice@127.0.0.1:15432/practice?schema=public
# Use a unique random secret of at least 32 characters for local development.
JWT_SECRET=
# Dedicated Judge0 submissions endpoint, for example http://127.0.0.1:2358/submissions
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Optional when the configured endpoint uses the RapidAPI gateway.
JUDGE0_RAPIDAPI_KEY=
# Standalone Redis endpoint from compose.yml.
REDIS_URL=redis://127.0.0.1:16379
# Set local explicitly for a single production process that does not use Redis.
JUDGE0_QUEUE_MODE=redis
JUDGE0_MAX_CONCURRENCY=8
JUDGE0_SEMAPHORE_KEY=dsa:practice:judge0:leases
# Seed reads this only when npm run db:seed is called.
PRACTICE_SEED_PASSWORD=
# Optional local teacher, super admin, and recruiter applicant accounts.
PRACTICE_STAFF_PASSWORD=
