  workEmail String @map("work_email") @db.VarChar(254)
  status   PracticeReviewStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("practice_recruiters")
}

model PracticeRecruiterInterest {
  id          String @id @default(uuid()) @db.Uuid
  candidateHandle String? @map("candidate_handle") @db.VarChar(32)
  recruiterId String @map("recruiter_id") @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  message     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  recruiter   User @relation("PracticeInterestRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User @relation("PracticeInterestCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt(sort: Desc), id(sort: Desc)], map: "practice_interest_candidate_recent_idx")
  @@index([recruiterId, createdAt(sort: Desc), id(sort: Desc)], map: "practice_interest_recruiter_recent_idx")
  @@index([recruiterId, candidateId, createdAt(sort: Desc), id(sort: Desc)], map: "practice_interest_pair_recent_idx")
  @@map("practice_recruiter_interests")
}

model PracticeAssessment {
  id              String @id @default(uuid()) @db.Uuid
  recruiterId     String @map("recruiter_id") @db.Uuid
  candidateId     String @map("candidate_id") @db.Uuid
  title           String @db.VarChar(100)
  durationMinutes Int @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  recruiter       User @relation("PracticeTestRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate       User @relation("PracticeTestCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  problems        PracticeAssessmentProblem[]
  solves          PracticeAssessmentSolve[]

  @@index([recruiterId])
  @@index([candidateId])
  @@map("practice_assessments")
}

model PracticeAssessmentProblem {
  assessmentId String @map("assessment_id") @db.Uuid
  problemId    String @map("problem_id") @db.Uuid
  position     Int
  version      Int
  assessment   PracticeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problem      Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([assessmentId, problemId])
  @@unique([assessmentId, position])
  @@index([problemId])
  @@map("practice_assessment_problems")
}

model PracticeAssessmentSolve {
  assessmentId String @map("assessment_id") @db.Uuid
  problemId    String @map("problem_id") @db.Uuid
  submissionId String @unique @map("submission_id") @db.Uuid
  assessment   PracticeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submission   PracticeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([assessmentId, problemId])
  @@map("practice_assessment_solves")
}


enum PracticePublicationKind {
  REPORT
  FEATURE
  CONTRIBUTION
  AMBASSADOR
}

enum PracticePublicationState {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  WITHDRAWN
}

model PracticePublication {
  payload Json?
  reviewReason String? @map("review_reason") @db.VarChar(1000)
  id         String  @id @default(uuid()) @db.Uuid
  authorId   String  @map("author_id") @db.Uuid
  kind       PracticePublicationKind
  state      PracticePublicationState @default(PENDING)
  title      String @db.VarChar(120)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  author     User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes      PracticePublicationVote[]
  ambassadorCollegeName String? @map("ambassador_college_name") @db.VarChar(200)
  ambassadorCollegeDomain String? @map("ambassador_college_domain") @db.VarChar(253)
  ambassadorRejectionReason String? @map("ambassador_rejection_reason") @db.VarChar(500)

  @@index([kind, state, createdAt])
  @@index([authorId])
  @@map("practice_publications")
}

model PracticePublicationVote {
  publicationId String @map("publication_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  publication   PracticePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([publicationId, userId])
  @@index([userId])
  @@map("practice_publication_votes")
}

model PracticeOpportunity {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(120)
  company   String   @db.VarChar(100)
  category  String   @db.VarChar(32)
  remote    Boolean  @default(false)
  summary   String
  applyUrl  String   @map("apply_url")
  closesAt  DateTime? @map("closes_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  published Boolean @default(false)
  clicks    Int     @default(0)

  sourceUrl         String?   @map("source_url")
  importFingerprint String?   @unique @map("import_fingerprint")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)

  @@index([published, closesAt])
  @@map("practice_opportunities")
}

model PracticeReferral {
  referredId  String @id @map("referred_id") @db.Uuid
  referrerId  String @map("referrer_id") @db.Uuid
  qualifiedAt DateTime? @map("qualified_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  referred    User @relation("PracticeReferred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer    User @relation("PracticeReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("practice_referrals")
}

model PracticeCredit {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  eventKey  String @unique @map("event_key")
  reason    String @db.VarChar(60)
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("practice_credits")
}

model PracticeReward {
  id       String @id @default(uuid()) @db.Uuid
  title    String @db.VarChar(120)
  details  String
  cost     Int
  stock    Int
  available Boolean @default(true)
  redemptions PracticeRedemption[]

  @@map("practice_rewards")
}

enum PracticeRedemptionState {
  PENDING
  FULFILLED
  CANCELLED
}

model PracticeRedemption {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  rewardId  String @map("reward_id") @db.Uuid
  cost      Int
  requestKey String @map("request_key") @db.Uuid
  state     PracticeRedemptionState @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward    PracticeReward @relation(fields: [rewardId], references: [id])

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([rewardId])
  @@map("practice_redemptions")
}


model PracticeDailyQuiz {
  day String @id @db.VarChar(10)
  questionId String @map("question_id")
  topic String
  prompt String
  choices Json
  answer Int
  explanation String
  @@map("practice_daily_quizzes")
}

model PracticeOperationalSettings {
  id String @id @default("global")
  version Int @default(1)
  maintenance Boolean @default(false)
  recruiterRegistration Boolean @default(true) @map("recruiter_registration")
  officerRegistration Boolean @default(true) @map("officer_registration")
  announcement String @default("") @db.VarChar(1000)
  @@map("practice_operational_settings")
}

model PracticeProgressReset {
  epochs PracticeProgressEpoch[]
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  resetAt DateTime @default(now()) @map("reset_at") @db.Timestamptz(3)
  snapshot Json
  @@index([userId, resetAt])
  @@map("practice_progress_resets")
}

model PracticeEditionMission {
  id String @id @db.VarChar(60)
  problemId String @map("problem_id") @db.Uuid
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  @@map("practice_edition_missions")
}

model PracticeProgressEpoch {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reset PracticeProgressReset @relation(fields: [resetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId String @id @map("user_id") @db.Uuid
  resetId String @map("reset_id") @db.Uuid
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)
  @@map("practice_progress_epochs")
}
