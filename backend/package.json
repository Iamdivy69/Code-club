    "catalogue:import": "tsx src/catalogue-cli.ts",
    "weekly-review": "node dist/weekly-review.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "google-auth-library": "10.9.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.6.1",
    "papaparse": "5.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.9.2",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "prisma": "7.10.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
