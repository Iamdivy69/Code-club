# Docker Compose local settings. Set a random value of at least 32 characters.
JWT_SECRET=
# Optional stable secret for profile links, at least 32 characters.
PRACTICE_PROFILE_SIGN_SECRET=
PRACTICE_BILLING_ENABLED=false
# Set at least 12 characters to create student@practice.test on startup.
PRACTICE_SEED_PASSWORD=
# Optional password shared by the local teacher, placement officer, recruiter, and admin fixtures.
PRACTICE_STAFF_PASSWORD=

# Configure the Judge0 endpoint used for Run, Submit, and the compiler.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_KEY=

# Optional OpenRouter-compatible chat completions endpoint for opportunity research.
PRACTICE_OPPORTUNITY_AI_URL=
PRACTICE_OPPORTUNITY_AI_MODEL=
PRACTICE_OPPORTUNITY_AI_KEY=

# Optional chat completions endpoint for learner-requested coaching and solver hints.
PRACTICE_COACHING_AI_URL=
PRACTICE_COACHING_AI_MODEL=
PRACTICE_COACHING_AI_KEY=
PRACTICE_WEB_PORT=3010

# Optional account and weekly practice email. Delivery also requires DSA SMTP settings.
PRACTICE_ACCOUNT_EMAIL_ENABLED=false
PRACTICE_PUBLIC_SIGNUP_ENABLED=false
PRACTICE_WEEKLY_REVIEW_ENABLED=false
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FRONTEND_URL=
PRACTICE_GOOGLE_CLIENT_ID=
PRACTICE_GOOGLE_CLIENT_SECRET=

# Optional authorized LeetCode stats provider. Manual entry is always available.
PRACTICE_LEETCODE_STATS_URL=
PRACTICE_LEETCODE_STATS_TOKEN=


# Isolated Docker rehearsals can override these without changing the demo.
PRACTICE_POSTGRES_PORT=15432
PRACTICE_REDIS_PORT=16379
PRACTICE_API_PORT=5010
